# ============================================================================
# LLM 模型列表
# ============================================================================
# 每个模型的关键字段：
#   name        : 模型别名，dbaa 内通过 /model <name> 切换
#   provider    : openai | ollama | anthropic
#   base_url    : LLM API 入口
#   model       : 厂商定义的模型 ID
#   api_key     : 厂商 API Key（本地部署可填 dummy）
#   capability  : large | medium | small（影响调度策略）
#   strip_think : true=剥离 <think>...</think> 思考标签后再展示给用户
# ============================================================================
models:
  # ---------------- 商用云模型 ----------------
  - name: deepseek-v4-pro
    provider: openai
    vendor: DeepSeek
    base_url: https://api.deepseek.com/v1
    model: deepseek-v4-pro
    capability: large
    api_key: REPLACE_WITH_YOUR_API_KEY
    strip_think: true
    description: DeepSeek-V4-Pro (思考模式)

  - name: glm-5.1
    provider: openai
    vendor: Zhipu AI
    base_url: https://open.bigmodel.cn/api/paas/v4
    model: glm-5.1
    capability: medium
    api_key: REPLACE_WITH_YOUR_API_KEY
    strip_think: true
    description: GLM-5.1 (智谱旗舰)

  - name: kimi-k2.6
    provider: openai
    vendor: Moonshot
    base_url: https://api.moonshot.cn/v1
    model: kimi-k2.6
    capability: medium
    api_key: REPLACE_WITH_YOUR_API_KEY
    strip_think: true
    description: Kimi-K2.6 (thinking 控制)

